# NOVARA COMMERCE — Production & Environment Configuration
# Safe placeholder values only (Never commit actual production secrets)

# Server Configuration
NODE_ENV=development
PORT=3000

# Mandatory MongoDB Atlas Persistent Database Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://db_user:YOUR_ATLAS_PASSWORD@cluster0.example.mongodb.net/novara_commerce?retryWrites=true&w=majority"

# Authentication Security (JWT secret)
JWT_SECRET="novara-secure-jwt-production-secret-replace-me"

# Cloudinary Mandatory Managed Image Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Resend Transactional Email API
RESEND_API_KEY="re_123456789"
EMAIL_FROM="orders@novaracommerce.com"

# Google OAuth 2.0 Credentials (Optional customer 3P login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth Credentials
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# Payment Gateway (bKash / SSLCommerz / Nagad)
PAYMENT_PROVIDER="bkash"
PAYMENT_PUBLIC_KEY="sandbox_bkash_app_key"
PAYMENT_SECRET_KEY="sandbox_bkash_app_secret"
